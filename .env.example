# Copy to .env (or .env.local) and fill in the values from your Supabase project.

# Supabase → Connect → Connection string
# Transaction pooler (port 6543) — used by the app at runtime
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres"
# Session pooler (port 5432) — used by drizzle-kit for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Server-only secret key (bypasses RLS) — used for inviting/deleting users.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_..."
