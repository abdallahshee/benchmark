# Supabase → Connect → Connection string
# Transaction pooler (port 6543): used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres"
# Session pooler (port 5432): used by drizzle-kit for migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:5432/postgres"

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-key>"

# Server-only secret key (bypasses RLS). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="<secret-key>"

